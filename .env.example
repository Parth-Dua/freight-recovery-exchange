# Agentverse external-LangGraph Agent URI, copied from the Agentverse registration UI.
# SECRET: the URI embeds the agent's private key (https://<handle>:<key>@agentverse.ai/<name>).
# Leave empty to run the graph locally without Agentverse registration.
AGENT_URI=
# Only needed if a graph node calls the ASI:One model. Phase 1 is deterministic and does not.
ASI1_API_KEY=
# Only if an Agentverse management API used in this implementation requires it:
# AGENTVERSE_API_KEY=
# true (default): agent polls the Agentverse mailbox, no public tunnel needed.
# false: register the --tunnel URL instead (official tunnel path).
AGENTVERSE_MAILBOX=true
LOG_LEVEL=INFO

# --- Phase 2: Tiger + carriers ---
# Tiger service URL WITHOUT the password; libpq reads the password from PGPASSWORD.
TIGER_DATABASE_URL=postgres://tsdbadmin@<service>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
PGPASSWORD=
# Public address of the Exchange Agent; carriers only answer requests signed by it.
EXCHANGE_AGENT_ADDRESS=
# Carrier private seeds: generate with `uv run python scripts/init_carrier_identities.py` (SECRET).
CARRIER_ATLAS_SEED=
CARRIER_BEACON_SEED=
CARRIER_COVE_SEED=
CARRIER_MERIDIAN_SEED=
CARRIER_DHOW_SEED=
CARRIER_TIMEOUT_SECONDS=8

# --- Phase 3: negotiation ---
NEGOTIATION_MODE=auto
NEGOTIATION_DISCOUNT_PCT=5

# --- Phase 4: Stripe TEST mode only (no real money). The app refuses any key not starting sk_test_.
STRIPE_TEST_SECRET=
# pk_test_… — only needed later for in-chat (Payment Protocol / embedded) checkout
STRIPE_TEST_PUBLISHABLE=
BOOKING_FEE_MINOR=2500
HOLD_TTL_SECONDS=1800
# Optional redirect after checkout (no website needed): defaults to https://asi1.ai/
# STRIPE_SUCCESS_URL=
